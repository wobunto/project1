@page "/battle"
@using MyGame.Services
@using MyGame.BattleCommanders
@using MyGame.BattleControllers
@using MyGame.BattleSystems
@using MyGame.ControllerStates
@using MyGame.Inputs
@using MyGame.Items
@using MyGame.Moves
@using MyGame.NameTables
@using MyGame.Pokemons
@using MyGame.Trainers
@using MyGame.Views
@inject BattleGameService GameService

@rendermode InteractiveServer
@implements IDisposable

<!-- 1. 로딩 상태 체크: 초기화 전에는 UI를 렌더링하지 않음 -->
@if (!GameService.IsInitialized || Controller == null)
{
    <div class="loading-box">
        <p>배틀 데이터를 불러오는 중...</p>
    </div>
}
else
{
    <div class="console-screen">
        <!-- 1. 포켓몬 상태창 (상대 & 플레이어) -->
        <div class="box pokemon-status">
            <div class="box-title">================ BATTLE ================</div>
            <div class="status-row">
                <span class="label">[상대]</span> 
                <span>@FormatPokemon(Controller.Enemy.ActivePokemon)</span>
                <div class="hp-bar-bg">
                    <div class="hp-bar-fill" style="width: @GetHpPercent(Controller.Enemy.ActivePokemon)%"></div>
                </div>
            </div>
            <div class="status-row">
                <span class="label">[나]  </span> 
                <span>@FormatPokemon(Controller.Player.ActivePokemon)</span>
                <div class="hp-bar-bg">
                    <div class="hp-bar-fill" style="width: @GetHpPercent(Controller.Player.ActivePokemon)%"></div>
                </div>
            </div>
            <div class="box-title">========================================</div>
        </div>

        <!-- 2. 메시지 / 안내창 -->
        <div class="box message-box">
            <p>@CurrentMessage</p>
            @if (Controller.CurrentState is not MenuState)
            {
                <small class="back-hint">
                    @(Controller.ForceSwitch ? "현재 교체를 해야 합니다." : "돌아가기: [뒤로 가기] 클릭")
                </small>
            }
        </div>

        <!-- 3. 메뉴 및 커맨드 창 -->
        <div class="box action-box">
            @switch (Controller.CurrentState)
            {
                case MenuState:
                    <!-- 메인 메뉴 -->
                    <div class="grid-2x2">
                        <button class="cmd-btn" @onclick="() => SendInput(1)">1. 싸운다</button>
                        <button class="cmd-btn" @onclick="() => SendInput(2)">2. 가방</button>
                        <button class="cmd-btn" @onclick="() => SendInput(3)">3. 교체</button>
                        <button class="cmd-btn" @onclick="() => SendInput(4)">4. 도망친다</button>
                    </div>
                    break;

                case AttackState:
                    <!-- 기술 선택 -->
                    <div class="grid-2x2">
                        @for (int i = 0; i < 4; i++)
                        {
                            int index = i + 1;
                            var move = GetMoveAt(i);
                            <button class="cmd-btn" @onclick="() => SendInput(index)" disabled="@(move == null || move.CurrentPP <= 0)">
                                @index. @FormatMove(move)
                            </button>
                        }
                    </div>
                    <button class="back-btn" @onclick="SendCancel">돌아가기</button>
                    break;

                case ItemState itemState:
                    <!-- 아이템 선택 -->
                    <div class="item-list">
                        @if (itemState.Items.Count == 0)
                        {
                            <div class="empty-msg">가방이 비어 있습니다.</div>
                        }
                        else
                        {
                            @for (int i = 0; i < itemState.Items.Count; i++)
                            {
                                int index = i + 1;
                                var item = itemState.Items[i];
                                <button class="list-btn" @onclick="() => SendInput(index)">
                                    @index. [ @item.Data.Name x @item.Count ]
                                </button>
                            }
                        }
                    </div>
                    <button class="back-btn" @onclick="SendCancel">돌아가기</button>
                    break;

                /* 교체 및 아이템 사용 대상 선택 공통 화면 */
                case SelectPokemonState selectState:
                    <div class="grid-2x3">
                        @for (int i = 0; i < 6; i++)
                        {
                            int index = i + 1;
                            var member = GetPartyMemberAt(i);
                            bool canSelect = member != null && selectState.Filter(member);

                            <button class="cmd-btn" @onclick="() => SendInput(index)" disabled="@(!canSelect)">
                                @index. @FormatPokemon(member)
                            </button>
                        }
                    </div>
                    @if (selectState.CanCancel)
                    {
                        <button class="back-btn" @onclick="SendCancel">돌아가기</button>
                    }
                    break;

                default:
                    <div class="loading">행동 진행 중...</div>
                    break;
            }
        </div>
    </div>
}

@code {
    // 1. Controller 프로퍼티를 GameService와 안전하게 연결
    private BattleController? Controller => GameService.Controller;
    private string CurrentMessage = "무엇을 할까?";
    private bool _isDisposed = false;

    private IEnumerable<PokemonRuntime> _playerParty => Controller?.Player.Party ?? 
                                                        Enumerable.Empty<PokemonRuntime>();
    private IEnumerable<MoveRuntime?> _currentMoves => Controller?.Player.ActivePokemon?.CurrentMoves ?? 
                                                        Enumerable.Empty<MoveRuntime?>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var bridgeView = new BlazorBattleView(msg =>
            {
                if (!_isDisposed)
                {
                    CurrentMessage = msg;
                    InvokeAsync(StateHasChanged);
                }
            });

            // 배틀 초기화 및 시작
            if (!GameService.IsInitialized)
            {
                // 백그라운드로 배틀 루프를 실행하되, 초기화 후 안전하게 이벤트를 연결
                _ = RunBattleBackgroundAsync(bridgeView);
            }
            else
            {
                SubscribeEvents();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RunBattleBackgroundAsync(IPlayerView bridgeView)
    {
        // 💡 2. StartNewBattleAsync를 실행
        // (만약 Service 내부에 Initialize와 RunLoop가 분리되어 있다면 Controller 생성 직후 바로 구독하는 것이 가장 이상적입니다)
        var battleTask = GameService.StartNewBattleAsync(view: bridgeView);

        // Controller가 준비될 때까지 잠시 대기 (컨트롤러 인스턴스 확보)
        while (Controller == null && !GameService.IsInitialized)
        {
            await Task.Delay(50);
        }

        // 💡 3. Controller가 준비된 직후 이벤트 구독 및 첫 화면 렌더링 강제 갱신!
        SubscribeEvents();
        await InvokeAsync(StateHasChanged);

        // 배틀 루프 완료 대기
        await battleTask;
    }

    private void SubscribeEvents()
    {
        if (Controller != null)
        {
            Controller.OnStateChanged -= HandleStateChanged; // 중복 구독 방지
            Controller.OnStateChanged += HandleStateChanged;
        }
    }

    private void HandleStateChanged()
    {
        if (!_isDisposed)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    // --- 마우스 입력 처리 ---
    private void SendInput(int val)
    {
        // 프로젝트에 정의된 방식에 맞춰 호출 (Input.Number(val) 또는 new Input(val))
        Controller?.HandleInput(Input.Number(val));
    }

    private void SendCancel()
    {
        Controller?.TryBackState(Input.Cancel);
    }

    // --- 포맷팅 함수 ---
    private string FormatPokemon(IViewPokemon? p)
    {
        if (p == null) return "--없음--";
        return $"{NameTable.GetPokemon(p.Id)} Lv.{p.Level} [{p.CurrentHp}/{p.MaxHp}]";
    }

    private string FormatMove(MoveRuntime? move)
    {
        if (move == null) return "------";
        return $"{MoveNameTable.Get(move.Data.Key)} ({move.CurrentPP}/{move.MaxPP})";
    }

    private MoveRuntime? GetMoveAt(int index) => _currentMoves.ElementAtOrDefault(index);

    private PokemonRuntime? GetPartyMemberAt(int index) => _playerParty.ElementAtOrDefault(index);

    private int GetHpPercent(IViewPokemon? p)
    {
        if (p == null || p.MaxHp <= 0) return 0;
        return Math.Clamp((int)((float)p.CurrentHp / p.MaxHp * 100), 0, 100);
    }

    public void Dispose()
    {
        _isDisposed = true;

        if (Controller != null)
        {
            Controller.OnStateChanged -= HandleStateChanged;
        }
    }

    // 배틀 시스템의 콘솔 메시지를 Blazor 화면의 CurrentMessage로 연결해주는 간이 View
    private class BlazorBattleView : IPlayerView
    {
        private readonly Action<string> _onMessage;
        public BlazorBattleView(Action<string> onMessage) => _onMessage = onMessage;

        public void DisplayMessage(string message) => _onMessage(message);
        public void DisplayBackInfo() { }
        public void DisplayCantBack() => _onMessage("지금은 돌아갈 수 없습니다.");
        public void DisplayStartBattle(IBattleCommander enemy) => _onMessage($"{enemy.NameId}과의 배틀이 시작됐다!");
        public void DisplayPokemon(IViewPokemon p1, IViewPokemon p2) { }
        public void DisplayCommandMenu() { }
        public void DisplayAttackMenu(IEnumerable<MoveRuntime?> moves) { }
        public void DisplayItemMenu(IReadOnlyList<InventoryItem> items) { }
        public void DisplayPartyMenu(IEnumerable<PokemonRuntime> party) { }
    }
}

<style>
    /* 레트로 콘솔/터미널 스타일 테마 */
    .console-screen {
        font-family: 'Consolas', 'Courier New', monospace;
        background-color: #121212;
        color: #f0f0f0;
        padding: 20px;
        width: 520px;
        margin: 20px auto;
        border: 4px solid #333;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
        outline: none; /* 포커스 아웃라인 제거 */
        user-select: none;
    }

    .box {
        background-color: #1a1a1a;
        border: 2px solid #444;
        border-radius: 4px;
        padding: 12px;
        margin-bottom: 12px;
    }

    .box-title {
        color: #777;
        text-align: center;
        margin: 4px 0;
        font-size: 13px;
    }

    /* 포켓몬 체력창 */
    .status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 6px 0;
        font-size: 14px;
    }

    .label {
        font-weight: bold;
        color: #ffd700;
        margin-right: 6px;
    }

    .hp-bar-bg {
        width: 100px;
        height: 8px;
        background: #333;
        border-radius: 4px;
        overflow: hidden;
        margin-left: 10px;
    }

    .hp-bar-fill {
        height: 100%;
        background: #00e676;
        transition: width 0.3s ease;
    }

    /* 메시지 창 */
    .message-box {
        min-height: 50px;
        font-size: 15px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .back-hint {
        color: #888;
        font-size: 12px;
        margin-top: 4px;
    }

    /* 2열 2행 (커맨드/기술) */
    .grid-2x2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    /* 2열 3행 (포켓몬 파티 목록) */
    .grid-2x3 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    /* 버튼 스타일 */
    .cmd-btn, .list-btn, .back-btn {
        font-family: inherit;
        background-color: #262626;
        color: #fff;
        border: 1px solid #555;
        padding: 10px;
        text-align: left;
        cursor: pointer;
        border-radius: 4px;
        font-size: 13px;
    }

    .cmd-btn:hover:not(:disabled), .list-btn:hover:not(:disabled) {
        background-color: #383838;
        border-color: #ffd700;
        color: #ffd700;
    }

    .cmd-btn:disabled {
        color: #555;
        cursor: not-allowed;
        border-color: #333;
    }

    .back-btn {
        width: 100%;
        margin-top: 8px;
        background-color: #331515;
        border-color: #772222;
        text-align: center;
    }

    .back-btn:hover {
        background-color: #551a1a;
    }

    /* 가방 아이템 목록 */
    .item-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        max-height: 140px;
        overflow-y: auto;
    }
</style>